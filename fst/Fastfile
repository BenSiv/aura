# fastlane/Fastfile
# This file defines the lanes (automation pipelines) for fastlane.

default_platform(:android)

platform :android do
  desc "Deploy a new version to the Google Play Store"
  lane :deploy do
    # 1. Build the production AAB using the existing Makefile
    # This ensures we use the exact same build process as manual builds
    sh("cd .. && make build")

    # 2. Upload the AAB and Metadata to Google Play
    # 'supply' is the fastlane tool for Google Play Store interaction
    supply(
      package_name: "com.bensivan.aura",
      json_key: "cfg/google-play-key.json",
      track: "internal", # Options: production, beta, alpha, internal
      aab: "pub/aura-release.aab",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      skip_upload_changelogs: true
    )
  end

  desc "Internal test flight - Uploads AAB to the internal sharing track"
  lane :internal do
    sh("cd .. && make build")
    supply(
      track: "internal",
      aab: "pub/aura-release.aab",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end
end
